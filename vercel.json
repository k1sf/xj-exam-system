{
  "version": 2,
  "name": "xj-exam-system",
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@3"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/[[...path]]" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
