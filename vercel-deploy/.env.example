# Supabase PostgreSQL 数据库连接字符串
PGDATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 或使用 DATABASE_URL
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# API Token（可选，用于前后端通信）
API_TOKEN=your_api_token_here

# 超级管理员密码哈希（可选）
# 生成方式: node -e "console.log(require('crypto').createHash('sha256').update('your_password' + '_super_recovery_salt_2026').digest('hex'))"
SUPER_ADMIN_HASH=your_super_admin_hash_here

# 邮件配置（可选，用于备份）
EMAIL_USER=your_email@qq.com
EMAIL_PASS=your_email_auth_code
BACKUP_EMAIL=backup_receiver@example.com
